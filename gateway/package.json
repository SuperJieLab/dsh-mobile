{
  "name": "dsh-mobile-gateway",
  "version": "0.2.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "private": true,
  "description": "Mac-side DSH plugin: exposes DSH session state to the dsh-mobile iPhone client",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run lint && node --test --test-timeout=30000 \"tests/**/*.test.ts\"",
    "lint": "oxlint --deny-warnings ."
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@types/node": "^26.6.5",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2"
  }
}
