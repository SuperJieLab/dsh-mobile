{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "off",
    "perf": "off",
    "style": "off",
    "pedantic": "off",
    "nursery": "off"
  },
  "rules": {
    "unicorn/no-useless-spread": "off"
  },
  "ignorePatterns": [
    "node_modules",
    ".build",
    "dist"
  ]
}
