{
  "about": [
    "两端共守的 mux 帧样本 —— 手机端与网关端各有一条判据读这一份。",
    "改这里的任何一行，两端都会红；只改一端自己的断言，另一端不会。",
    "client 段：字节由手机端编出，网关端解析。text 是精确字节（手机端按 .sortedKeys 编码，键序确定）。",
    "server 段：网关端编出，手机端只解析。**字节比对由产出侧做**：网关侧用手写的语义再编码，",
    "与 text 逐字相等；所以新增样本的 text 必须照那份字面量的键序写（JSON.stringify 按插入顺序），",
    "按字母序写必红。",
    "端点名与上游逐字一致：session/follow、session/control、$events（后两者无入参，args 为空对象）。"
  ],
  "client": [
    {
      "name": "follow",
      "text": "{\"endpoint\":\"session/follow\",\"payload\":{\"args\":{\"request\":{\"address\":{\"kind\":\"session\",\"sessionId\":\"s-1\"},\"activate\":true,\"assistantStream\":true,\"maxMessages\":500,\"turnWindow\":{\"minMessages\":50,\"minTurns\":2}}}},\"streamId\":\"s-9\",\"type\":\"open\"}",
      "type": "open",
      "streamId": "s-9",
      "kind": "follow",
      "sessionId": "s-1"
    },
    {
      "name": "events",
      "text": "{\"endpoint\":\"$events\",\"payload\":{\"args\":{}},\"streamId\":\"e-1\",\"type\":\"open\"}",
      "type": "open",
      "streamId": "e-1",
      "kind": "events"
    },
    {
      "name": "control",
      "text": "{\"endpoint\":\"session/control\",\"payload\":{\"args\":{}},\"streamId\":\"c-1\",\"type\":\"open\"}",
      "type": "open",
      "streamId": "c-1",
      "kind": "control"
    },
    {
      "name": "workspace",
      "text": "{\"endpoint\":\"workspace/follow\",\"payload\":{\"args\":{}},\"streamId\":\"g-1\",\"type\":\"open\"}",
      "type": "open",
      "streamId": "g-1",
      "kind": "workspace"
    },
    {
      "name": "cancel",
      "text": "{\"streamId\":\"s-9\",\"type\":\"cancel\"}",
      "type": "cancel",
      "streamId": "s-9"
    }
  ],
  "server": [
    {
      "name": "item-follow-opening",
      "text": "{\"type\":\"item\",\"streamId\":\"s-9\",\"value\":{\"type\":\"snapshot\",\"header\":{\"version\":1,\"id\":\"s-1\",\"createdAt\":1700000000000,\"cwd\":\"/Users/x/proj\",\"isSeeded\":false},\"cursor\":3,\"records\":[{\"type\":\"event\",\"event\":{\"type\":\"user/message\",\"seq\":3,\"time\":1700000000003,\"data\":{\"text\":\"m3\"}}}],\"hasMore\":false,\"projections\":{\"asOfSeq\":3,\"values\":{}}}}",
      "type": "item",
      "streamId": "s-9",
      "kind": "follow"
    },
    {
      "name": "item-events-question",
      "text": "{\"type\":\"item\",\"streamId\":\"e-1\",\"value\":{\"type\":\"waterfall\",\"event\":\"user-questions/request\",\"eventId\":\"ev-2\",\"agentId\":\"s-1\",\"request\":{\"questions\":[{\"id\":\"q-1\",\"header\":\"选择方案\",\"question\":\"用哪一条？\",\"options\":[{\"label\":\"A\",\"description\":\"快\"},{\"label\":\"B\"}]},{\"id\":\"q-2\",\"question\":\"同时改测试吗？\",\"options\":[{\"label\":\"要\"},{\"label\":\"不要\"}],\"multiSelect\":true}]}}}",
      "type": "item",
      "streamId": "e-1",
      "kind": "events"
    },
    {
      "name": "item-events-emit",
      "text": "{\"type\":\"item\",\"streamId\":\"e-1\",\"value\":{\"type\":\"emit\",\"event\":\"commands/change\",\"args\":[]}}",
      "type": "item",
      "streamId": "e-1",
      "kind": "events"
    },
    {
      "name": "item-events-ready",
      "text": "{\"type\":\"item\",\"streamId\":\"e-1\",\"value\":{\"type\":\"ready\",\"clientId\":\"c-1\",\"host\":{\"home\":\"/Users/x/proj\"}}}",
      "type": "item",
      "streamId": "e-1",
      "kind": "events"
    },
    {
      "name": "item-events-waterfall",
      "text": "{\"type\":\"item\",\"streamId\":\"e-1\",\"value\":{\"type\":\"waterfall\",\"event\":\"approval/request\",\"eventId\":\"ev-1\",\"agentId\":\"s-1\",\"request\":{\"toolName\":\"Bash\",\"reason\":\"需要读写工作区\"}}}",
      "type": "item",
      "streamId": "e-1",
      "kind": "events"
    },
    {
      "name": "item-workspace-baseline",
      "text": "{\"type\":\"item\",\"streamId\":\"g-1\",\"value\":{\"type\":\"baseline\",\"value\":{\"items\":[{\"workspaceId\":\"w-1\",\"path\":\"/Users/x/记账\",\"title\":\"记账\",\"sessionIds\":[\"s-1\"]}],\"archivedSessionIds\":[],\"pinnedSessionIds\":[\"s-1\"]}}}",
      "type": "item",
      "streamId": "g-1",
      "kind": "workspace"
    },
    {
      "name": "end",
      "text": "{\"type\":\"end\",\"streamId\":\"s-9\"}",
      "type": "end",
      "streamId": "s-9"
    },
    {
      "name": "error",
      "text": "{\"type\":\"error\",\"streamId\":\"s-9\",\"error\":{\"code\":\"unknown-endpoint\",\"message\":\"no such endpoint\",\"details\":{}}}",
      "type": "error",
      "streamId": "s-9"
    }
  ]
}
