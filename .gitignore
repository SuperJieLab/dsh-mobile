# 上游 clone（只读地基，不纳入版本库）
deepseek-harness/

# agent 记忆
.workbuddy/

# 开发工作区（约束与计划，不随仓库发布）
dev/

docs/

# Node
node_modules/
dist/
*.log

# macOS
.DS_Store

# 证书与私钥（gen-certs.sh 产物；私钥永不进仓库，见 deploy/HEADSCALE.md §2）
deploy/tls/
*.crt
*.key
*.pem

# 归档产物（scripts/release.sh 的 .xcarchive 与 ipa）
# 锚定根目录（前导斜杠）：只挡仓库根的 build/，不误伤子目录里叫 build 的东西。
/build/

# Xcode
ios/build/
ios/.build/
ios/.dd/
ios/DerivedData/
ios/.derived/
xcuserdata/
# 本地 SPM 包的缓存与 Xcode 元数据（解析包时会在包目录里生成）
ios/Vendor/*/.build/
ios/Vendor/*/.swiftpm/
# xcodebuild 的输出重定向（老版本脚本用 .txt，新脚本用 .log —— 两类都别进仓库）
ios/.*.txt

# CI 闸门的日志（scripts/ci.sh 的产物）
# 每台机器的 bundle id 与开发团队 —— 自己的值不进仓库（模板见 ios/Config/Shared.xcconfig）
ios/Config/Local.xcconfig

ci-out/

# 运行时的凭据与配置（绝不该进仓库）
# 网关的配对关系在 ~/.dsh 下，正常不会落到仓库里 —— 这条防的是「顺手拷一份」。
credentials.json
.env
.env.*
*.local
